# Cloudflare Pages — Security Headers
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://eormhcupwgwpllhrfxxg.supabase.co https://wmfbw7ff71.execute-api.us-east-1.amazonaws.com https://cloudflareinsights.com; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; upgrade-insecure-requests

# Static JS/CSS — long cache (filenames have hashes)
/static/*
  Cache-Control: public, max-age=31536000, immutable

# HTML — no cache (always fresh)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# index.html specifically
/
  Cache-Control: public, max-age=0, must-revalidate
