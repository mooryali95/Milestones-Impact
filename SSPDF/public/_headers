# Cloudflare Pages — Security Headers
# لا سكربت مضمّن ولا خارجي: كل JavaScript من الموقع نفسه، فلا تُنفَّذ أي حقنة.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://eormhcupwgwpllhrfxxg.supabase.co wss://eormhcupwgwpllhrfxxg.supabase.co https://cloudflareinsights.com; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests

# أصول Vite تحمل بصمة في اسمها، فتُخزَّن سنة كاملة بلا إعادة تحقق
/assets/*
  Cache-Control: public, max-age=31536000, immutable
