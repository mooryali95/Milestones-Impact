  Cache-Control: no-cache
/legal/*
  Cache-Control: no-cache
/j/*
  Cache-Control: no-cache
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# الفيديو التعريفي باسم بإصدار (intro-v3)، فيُخزَّن طويلًا ويتغير الاسم عند إعادة التوليد
# وصفحة البرنامج في الموقع العام تعرضه بترجمته: ملف الترجمة من أصل آخر لا يُحمَّل إلا بـCORS (الفيديو هناك بـcrossorigin="anonymous")
/media/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: https://mi.sunkvalue.com
