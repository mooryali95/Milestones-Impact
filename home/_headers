# Cloudflare Pages — Security Headers
# CSP لا تمسّ السكربتات والأنماط المضمّنة: تمنع التضمين في مواقع أخرى،
# والإضافات (object/embed)، وتغيير <base>، وإرسال النماذج لعناوين خارجية.
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; media-src 'self'; connect-src 'self' https://eormhcupwgwpllhrfxxg.supabase.co https://cloudflareinsights.com; form-action 'self' mailto:; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; upgrade-insecure-requests

# JS files — short cache to allow updates
/assets/js/*
  Cache-Control: public, max-age=3600, must-revalidate

# Static assets (images, fonts) — long cache
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

# HTML — no cache (always fresh)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Brand assets (SVG logos, social images) — long cache
/assets/brand/*
  Cache-Control: public, max-age=31536000, immutable

# Intro video — long cache
/assets/video/*
  Cache-Control: public, max-age=31536000, immutable

# Favicons & manifest — medium cache
/favicon.*
  Cache-Control: public, max-age=604800

/apple-touch-icon*.png
  Cache-Control: public, max-age=604800

/android-chrome-*.png
  Cache-Control: public, max-age=604800

/site.webmanifest
  Cache-Control: public, max-age=604800

# Program pages (/leaders, /projects) — shared assets
/assets/program/js/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/program/css/*
  Cache-Control: public, max-age=31536000, immutable

# صفحة التسعير مخفية: لا تُفهرس ولا تظهر في الموقع
/pricing.html
  X-Robots-Tag: noindex, nofollow

/pricing
  X-Robots-Tag: noindex, nofollow
