{
  "name": "milestone-impact",
  "version": "5.0.0",
  "private": true,
  "engines": { "node": ">=20 <23" },
  "description": "Milestone Impact — مصفوفة التأثير • هندسة اجتماعية",
  "dependencies": {
    "@simplewebauthn/browser": "13.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^18.2.0",
    "write-excel-file": "^4.1.1"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "leaders:dev": "vite --config leaders-app/vite.config.js",
    "leaders:build": "vite build --config leaders-app/vite.config.js",
    "admin:dev": "vite --config admin-app/vite.config.js",
    "admin:build": "vite build --config admin-app/vite.config.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --no-eslintrc -c .eslintrc.ci.json \"src/**/*.{js,jsx}\" \"leaders-app/src/**/*.{js,jsx}\" \"admin-app/src/**/*.{js,jsx}\"",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.7",
    "@babel/plugin-syntax-jsx": "^7.29.7",
    "@electric-sql/pglite": "^0.2.17",
    "@playwright/test": "1.56.1",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^25.0.1",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
