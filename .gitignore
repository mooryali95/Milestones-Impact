# Dependencies
node_modules/
*/node_modules/

# Production build output (Cloudflare Pages builds this from source — never commit it)
/build/
SSPDF/dist/

# Environment files (secrets live in the host's env settings, not the repo)
.env
.env.local
.env.*.local
*/.env
!*/.env.example

# Logs & OS cruft
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store

# package-lock.json is committed again. It was excluded because
# react-scripts' loose peer deps produced a lockfile `npm ci` rejected;
# Vite's tree resolves cleanly, so builds are reproducible once more.
test-results/
playwright-report/
.probe/

# ناتج محلي لفحص deno خارج CI. المودع منها اثنان: supabase/functions/deno.lock (يفحص به CI مجمّدًا)
# وsupabase/functions/leaders-api/deno.lock (بجانب deno.json الدالة)، تصور تحديث المنصة المرحلة 2 البند 7
deno.lock
!supabase/functions/deno.lock

# Supabase المحلي (supabase start)
supabase/.temp/
supabase/.branches/

# مجلدات التسجيل المؤقتة لمسجّل الفيديو (shared/video/record.mjs)
leaders-app/public/media/.rec-*/
leaders/media/.rec-*/
# تصدير المحتوى الحي للمقارنة (scripts/content/export-live.mjs)
.content-live/
supabase/functions/agent-chat/evals/last-run-*.json
