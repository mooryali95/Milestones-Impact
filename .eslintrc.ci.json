{
  "root": true,
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    },
    "requireConfigFile": false,
    "babelOptions": {
      "plugins": [
        [
          "@babel/plugin-syntax-jsx"
        ]
      ]
    }
  },
  "env": {
    "browser": true,
    "es2022": true,
    "jest": true,
    "node": true
  },
  "globals": {
    "vi": "readonly"
  },
  "plugins": [
    "react"
  ],
  "settings": {
    "react": {
      "version": "detect"
    }
  },
  "rules": {
    "no-undef": "error",
    "react/jsx-uses-vars": "error",
    "react/jsx-uses-react": "error",
    "react/jsx-no-undef": "error"
  },
  "parser": "@babel/eslint-parser"
}